# Google Gemini API Configuration
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Yahoo Finance Configuration
# Get your key at: https://rapidapi.com/apidojo/api/yahoo-finance15
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=yahoo-finance15.p.rapidapi.com

# JWT secret — set a long random string in production
JWT_SECRET=change-me-in-production-use-a-32-char-random-string

# SQLite database path (relative to api/ working directory)
# Defaults to ./aura.db if not set
DATABASE_PATH=./aura.db

# Ollama (local or cloud-hosted open-source models)
# Ollama has no built-in auth — it's designed for local use.
# When self-hosting in the cloud, put Ollama behind a reverse proxy
# (nginx/Caddy) that checks a Bearer token, or use a managed platform
# like OpenRouter / Together AI that wraps Ollama with an API key.
#
# Base URL of your Ollama server (default: http://localhost:11434)
# OLLAMA_BASE_URL=https://your-cloud-ollama-server.com
#
# API key — sent as "Authorization: Bearer <key>" if set.
# Leave blank for local Ollama (no auth needed on localhost).
# OLLAMA_API_KEY=your_ollama_api_key_here
